<Window x:Class="CybersecurityBotWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cybersecurity Awareness Bot" Height="550" Width="800"
        WindowStartupLocation="CenterScreen">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto" MinHeight="255"/>
			<RowDefinition/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!-- ASCII Art Header -->
		<TextBox x:Name="AsciiArtBox" Grid.Row="0" FontFamily="Consolas" FontSize="10"
                 Background="Black" Foreground="Cyan" TextWrapping="Wrap"
                 IsReadOnly="True" Margin="0,4,0,10"/>

		<!-- Chat Display Area -->
		<ListBox x:Name="ChatDisplay" Grid.Row="1" FontFamily="Segoe UI" FontSize="14"
                 Background="#1e1e1e" Foreground="White" Margin="0,5,0,5">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<!-- Input Area -->
		<Grid Grid.Row="2" Margin="0,5,0,-5">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			<TextBox x:Name="UserInput" Grid.Column="0" FontSize="14" Height="35"
                     KeyDown="UserInput_KeyDown" Margin="0,0,5,0"/>
			<Button x:Name="SendButton" Grid.Column="1" Content="Send" Width="80"
                    Height="35" Click="SendButton_Click" Margin="0,0,5,0"/>
			<Button x:Name="VoiceButton" Grid.Column="2" Content="🎵 Greeting" Width="100"
                    Height="35" Click="VoiceButton_Click"/>
		</Grid>
	</Grid>
</Window>